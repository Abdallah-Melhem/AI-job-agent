# ─── Environment Variables ───────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Replace with your MongoDB Atlas URI or local/Docker connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random string: openssl rand -hex 64
JWT_SECRET=replace_with_a_strong_random_secret

# ── Ollama (Local AI) ────────────────────────────────────────────────────────
# When running via Docker Compose, set to: http://ollama:11434
# When running locally (npm run dev), set to: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Frontend URL (CORS) ──────────────────────────────────────────────────────
# In development: http://localhost:5173 or http://localhost:5174
# In production:  your actual domain
FRONTEND_URL=http://localhost:5174

# ── Optional: Composio Integration ──────────────────────────────────────────
# Get your key from: dashboard.composio.dev → Platform → Getting Started
COMPOSIO_API_KEY=your_composio_api_key_here
